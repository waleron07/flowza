// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  superAdmin
  admin
  moderator
  operator
  user
}

enum OrderStatus {
  NEW
  CONFIRMED
  COOKING
  READY
  DELIVERING
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

enum ImageEntityType {
  PRODUCT
  CATEGORY
  TENANT
  USER
}

enum ImageType {
  MAIN
  GALLERY
  AVATAR
}

enum PaymentMethod {
  CARD
  CASH
  APPLE_PAY
  GOOGLE_PAY
}

enum DiscountType {
  PERCENT
  FIXED
  DAY
  WEEK
  MONTH
  PROMO
}

enum PromoCodeType {
  PERCENT
  FIXED
}

model Tenant {
  id               Int                  @id @default(autoincrement())
  name             String
  slug             String               @unique
  description      String?
  heroTitle        String?
  heroSubtitle     String?
  heroDescription  String?
  heroImageUrl     String?
  seoTitle         String?
  seoDescription   String?
  isActive         Boolean              @default(true)
  phone            String?
  address          String?
  timezone         String               @default("UTC")
  workingHours     Json?
  deliveryFee      Int                  @default(0)
  minOrderAmount   Int                  @default(0)
  subscription     DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  primaryUsers     User[]
  staffAssignments UserTenantAccess[]
  categories       Category[]
  products         Product[]
  addresses        Address[]
  carts            Cart[]
  orders           Order[]
  promoCodes       PromoCode[]
  discounts        Discount[]
}

model User {
  id               Int                @id @default(autoincrement())
  email            String             @unique
  emailVerifiedAt  DateTime?
  phone            String             @unique
  passwordHash     String
  role             UserRole           @default(user)
  login            String             @unique
  isActive         Boolean            @default(true)
  avatarId         Int?
  primaryTenantId  Int?
  avatar           Image?             @relation("UserAvatar", fields: [avatarId], references: [id], onDelete: SetNull)
  primaryTenant    Tenant?            @relation(fields: [primaryTenantId], references: [id], onDelete: SetNull)
  staffAssignments UserTenantAccess[]
  addresses        Address[]
  carts            Cart[]
  reviews          Review[]
  auditLogs        AuditLog[]
  orders           Order[]
  orderComments    OrderComment[]
  emailVerificationCodes EmailVerificationCode[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([avatarId])
  @@index([primaryTenantId])
  @@index([role])
}

model EmailVerificationCode {
  id        Int      @id @default(autoincrement())
  userId    Int
  codeHash  String
  expiresAt DateTime
  usedAt    DateTime?
  attempts  Int      @default(0)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([userId, usedAt])
}

model UserTenantAccess {
  userId     Int
  tenantId   Int
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([userId, tenantId])
  @@index([tenantId])
}

model Category {
  id              Int       @id @default(autoincrement())
  tenantId        Int
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name            String
  description     String?
  imageUrl        String?
  isActive        Boolean   @default(true)
  deletedAt       DateTime?
  sortOrder       Int       @default(0)
  products        Product[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([tenantId])
  @@unique([tenantId, name])
}

model Product {
  id              Int         @id @default(autoincrement())
  tenantId        Int
  tenant          Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  categoryId      Int
  category        Category    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  name            String
  description     String?
  imageUrl        String?
  badgeText       String?
  price           Int
  currency        String      @default("RUB")
  isActive        Boolean     @default(true)
  deletedAt       DateTime?
  variants        ProductVariant[]
  modifiers       Modifier[]
  modifierGroups  ModifierGroup[]
  discounts       Discount[]
  reviews         Review[]
  cartItems       CartItem[]
  orderItems      OrderItem[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([tenantId])
  @@index([categoryId])
  @@unique([tenantId, name])
}

model Image {
  id          Int             @id @default(autoincrement())
  url         String
  entityId    Int
  entityType  ImageEntityType
  type        ImageType
  alt         String?
  sortOrder   Int             @default(0)
  avatarUsers User[]          @relation("UserAvatar")
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([entityType, entityId])
  @@index([type])
}

model Address {
  id        Int      @id @default(autoincrement())
  userId    Int
  tenantId  Int?
  label     String?
  address   String
  lat       Float?
  lng       Float?
  comment   String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orders    Order[]

  @@index([userId])
  @@index([tenantId])
}

model ProductVariant {
  id         Int         @id @default(autoincrement())
  productId  Int
  name       String
  price      Int
  currency   String      @default("RUB")
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]
  cartItems  CartItem[]

  @@index([productId])
}

model Modifier {
  id                 Int                 @id @default(autoincrement())
  name               String
  price              Int
  productId          Int
  groupId            Int?
  sortOrder          Int                 @default(0)
  deletedAt          DateTime?
  product            Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  group              ModifierGroup?      @relation(fields: [groupId], references: [id], onDelete: SetNull)
  orderItemModifiers OrderItemModifier[]
  cartItemModifiers  CartItemModifier[]

  @@index([productId])
  @@index([groupId])
}

model ModifierGroup {
  id         Int        @id @default(autoincrement())
  productId  Int
  name       String
  minSelect  Int        @default(0)
  maxSelect  Int        @default(1)
  sortOrder  Int        @default(0)
  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  modifiers  Modifier[]

  @@index([productId])
}

model Order {
  id            Int           @id @default(autoincrement())
  orderNumber   String        @unique
  tenantId      Int
  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  userId        Int
  user          User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  promoCodeId   Int?
  addressId     Int?
  promoCode     PromoCode?    @relation(fields: [promoCodeId], references: [id], onDelete: SetNull)
  address       Address?      @relation(fields: [addressId], references: [id], onDelete: SetNull)
  status        OrderStatus   @default(NEW)
  paymentMethod PaymentMethod
  paymentStatus PaymentStatus @default(PENDING)
  currency      String        @default("RUB")
  deliveryAddress String
  staffComment  String?
  deliveryLat   Float?
  deliveryLng   Float?
  paidAt        DateTime?
  confirmedAt   DateTime?
  deliveredAt   DateTime?
  cancelledAt   DateTime?
  subtotal      Int
  deliveryFee   Int
  discountAmount Int         @default(0)
  finalAmount   Int
  items         OrderItem[]
  comments      OrderComment[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([tenantId])
  @@index([userId])
  @@index([addressId])
  @@index([promoCodeId])
  @@index([status])
  @@index([createdAt])
  @@index([tenantId, createdAt])
}

model OrderComment {
  id        Int      @id @default(autoincrement())
  orderId    Int
  authorId   Int?
  comment    String
  createdAt  DateTime @default(now())
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  author     User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([authorId])
  @@index([orderId, createdAt])
}

model OrderItem {
  id               Int                 @id @default(autoincrement())
  orderId          Int
  order            Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId        Int
  product          Product             @relation(fields: [productId], references: [id], onDelete: Restrict)
  variantId        Int?
  variant          ProductVariant?     @relation(fields: [variantId], references: [id], onDelete: SetNull)
  productName      String
  variantName      String?
  quantity         Int
  unitPrice        Int
  originalPrice    Int
  discountApplied  Int                 @default(0)
  totalPrice       Int
  modifiers        OrderItemModifier[]

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
}

model OrderItemModifier {
  id          Int       @id @default(autoincrement())
  orderItemId Int
  modifierId  Int
  name        String
  price       Int
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  modifier    Modifier  @relation(fields: [modifierId], references: [id], onDelete: Restrict)

  @@index([orderItemId])
  @@index([modifierId])
}

model Cart {
  id        Int        @id @default(autoincrement())
  userId    Int
  tenantId  Int
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@unique([userId, tenantId])
  @@index([userId])
  @@index([tenantId])
}

model CartItem {
  id        Int                @id @default(autoincrement())
  cartId    Int
  productId Int
  variantId Int?
  quantity  Int                @default(1)
  cart      Cart               @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant   ProductVariant?    @relation(fields: [variantId], references: [id], onDelete: SetNull)
  modifiers CartItemModifier[]

  @@index([cartId])
  @@index([productId])
  @@index([variantId])
}

model CartItemModifier {
  id         Int      @id @default(autoincrement())
  cartItemId Int
  modifierId Int
  name       String
  price      Int
  cartItem   CartItem @relation(fields: [cartItemId], references: [id], onDelete: Cascade)
  modifier   Modifier @relation(fields: [modifierId], references: [id], onDelete: Restrict)

  @@index([cartItemId])
  @@index([modifierId])
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  action    String
  entity    String
  entityId  Int
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt])
}

model Review {
  id        Int      @id @default(autoincrement())
  userId    Int
  productId Int
  rating    Int
  comment   String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([productId])
  @@unique([userId, productId])
}

model PromoCode {
  id        Int      @id @default(autoincrement())
  code      String
  tenantId   Int?
  type      PromoCodeType
  value     Int
  maxUses   Int?
  usedCount Int      @default(0)
  expiresAt DateTime?
  isActive  Boolean  @default(true)
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orders    Order[]
  createdAt DateTime @default(now())

  @@unique([code, tenantId])
  @@index([tenantId])
}

model Discount {
  id        Int       @id @default(autoincrement())
  productId Int?
  tenantId  Int?
  type      DiscountType
  value     Int
  isActive  Boolean   @default(true)
  priority  Int       @default(0)
  startsAt  DateTime?
  endsAt    DateTime?
  product   Product?  @relation(fields: [productId], references: [id], onDelete: Cascade)
  tenant    Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([tenantId])
  @@index([type])
}
